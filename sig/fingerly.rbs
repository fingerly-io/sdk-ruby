# Type signatures for the Fingerly server SDK.
#
# RBS is Ruby's answer to a typed public surface: an editor, Steep or a
# consumer's own type check reads these without the SDK shipping a type
# checker. `signatures_test.rb` asserts that every method named here exists,
# so a reader that was added by metaprogramming cannot drift out of them.

module Fingerly
  VERSION: String

  class Error < StandardError
  end

  class ConfigurationError < ArgumentError
  end

  class APIError < Error
    attr_reader status: Integer
    attr_reader code: String?
    attr_reader details: untyped
    attr_reader request_id: String?
    attr_reader retry_after: Integer?

    def initialize: (
      status: Integer,
      ?code: String?,
      ?details: untyped,
      ?request_id: String?,
      ?retry_after: Integer?
    ) -> void
    def event_not_found?: () -> bool
    def pending?: () -> bool
    def event_already_consumed?: () -> bool
  end

  class EventAlreadyConsumedError < APIError
    CODE: String

    attr_reader consumed_at: String?

    def initialize: (
      status: Integer,
      ?code: String?,
      ?details: untyped,
      ?request_id: String?,
      ?retry_after: Integer?,
      ?consumed_at: String?
    ) -> void
  end

  class DeviceCheckError < APIError
    NOT_HELD: String
    SPENT: String
    BUSY: String
    CREDENTIAL_UNAVAILABLE: String
    BITS_REQUIRED: String
    APPLE_REJECTED: String
    UNAVAILABLE: String

    attr_reader apple_status: Integer?

    def not_held?: () -> bool
    def spent?: () -> bool
    def busy?: () -> bool
    def credential_unavailable?: () -> bool
    def bits_required?: () -> bool
    def apple_rejected?: () -> bool
    def unavailable?: () -> bool
  end

  class TimeoutError < Error
  end

  class ConnectionError < Error
  end

  class EventTrigger
    SIGNAL_ATTESTATION_FAILED: String
    SIGNAL_ATTESTATION_MISSING: String
    SIGNAL_ATTESTATION_DOWNGRADE: String
    SIGNAL_DEVICE_INCONSISTENT: String
    SIGNAL_REPORT_INCOMPLETE: String
    SIGNAL_PROBE_ERRORS: String
    SIGNAL_FETCH_METADATA_MISSING: String
    SIGNAL_TAMPERING: String
    SIGNAL_BROWSER_TAMPERING: String
    SIGNAL_CUSTOM_ROOT_CA: String
    SIGNAL_SECONDARY_USER_PROFILE: String
    V3_SIGNALS: Array[String]

    attr_reader signal: String?
    attr_reader group: String?
    attr_reader weight: Integer
    attr_reader confidence: String?

    def initialize: (Hash[String, untyped]) -> void
  end

  class Event
    STRING_FIELDS: Array[String]

    attr_reader request_id: String?
    attr_reader project_id: String?
    attr_reader visitor_id: String?
    attr_reader state: String?
    attr_reader reason: String?
    attr_reader environment: String?
    attr_reader platform: String?
    attr_reader sdk_platform: String?
    attr_reader sdk_version: String?
    attr_reader origin: String?
    attr_reader url_host: String?
    attr_reader url_path: String?
    attr_reader tag: String?
    attr_reader ip_network: String?
    attr_reader country_code: String?
    attr_reader country_name: String?
    attr_reader asn: String?
    attr_reader asn_name: String?
    attr_reader anonymity_network: String?
    attr_reader agent: String?
    attr_reader agent_version: String?
    attr_reader os: String?
    attr_reader device_kind: String?
    attr_reader visitor_kind: String?
    attr_reader suspect_level: String?

    attr_reader occurred_at: Time?
    attr_reader suspect_score: Integer?
    attr_reader triggers: Array[EventTrigger]
    attr_reader document: Hash[String, untyped]?
    attr_reader raw: Hash[String, untyped]

    def initialize: (Hash[String, untyped], ?lenient_time: bool) -> void
    def has_document?: () -> bool
    def scored?: () -> bool
  end

  class EventPage
    include Enumerable[Event]

    attr_reader rows: Array[Event]
    attr_reader page: Integer
    attr_reader page_size: Integer
    attr_reader raw: Hash[String, untyped]

    def initialize: (Hash[String, untyped]) -> void
    def each: () { (Event) -> void } -> Array[Event]
            | () -> Enumerator[Event, Array[Event]]
  end

  class EventConsumption
    attr_reader request_id: String?
    attr_reader consumed_at: String?
    attr_reader first: bool
    attr_reader raw: Hash[String, untyped]

    def initialize: (Hash[String, untyped]) -> void
    def first?: () -> bool
  end

  class EventVerification
    NOT_FOUND: String
    TOO_OLD: String
    TAG_MISMATCH: String
    UNIDENTIFIABLE: String
    UNSCORED: String
    ALREADY_CONSUMED: String
    REASONS: Array[String]

    attr_reader ok: bool
    attr_reader reason: String
    attr_reader event: Event?

    def initialize: (reason: String, event: Event?) -> void
    def ok?: () -> bool
  end

  class DeviceCheckBits
    attr_reader found: bool
    attr_reader bit0: bool
    attr_reader bit1: bool
    attr_reader last_update: String?
    attr_reader raw: Hash[String, untyped]

    def initialize: (Hash[String, untyped]) -> void
    def found?: () -> bool
  end

  class DeviceCheckWrite
    attr_reader bit0: bool?
    attr_reader bit1: bool?
    attr_reader raw: Hash[String, untyped]

    def initialize: (Hash[String, untyped]) -> void
  end

  class WebhookEvent
    attr_reader id: String?
    attr_reader type: String?
    attr_reader version: Integer?
    attr_reader organization_id: String?
    attr_reader environment: String?
    attr_reader created_at: Time?
    attr_reader data: Hash[String, untyped]
    attr_reader raw: Hash[String, untyped]

    def initialize: (Hash[String, untyped]) -> void
  end

  class Client
    DEFAULT_TIMEOUT: Integer
    DEFAULT_API_VERSION: String
    USER_AGENT: String
    MAX_ERROR_BODY: Integer

    DEVICE_CHECK_ATTEMPTS: Integer
    DEVICE_CHECK_BACKOFF: Array[Float]
    DEVICE_CHECK_MAX_WAIT: Integer

    attr_reader events: Events
    attr_reader device_check: DeviceCheck

    def initialize: (
      secret_key: String,
      ?endpoint: String?,
      ?api_version: String,
      ?timeout: Numeric,
      ?configure_http: (^(untyped) -> void)?,
      ?allow_insecure_loopback: bool
    ) -> void
    def close: () -> void
    def get: (String) -> Hash[String, untyped]
    def spend_device_check: (untyped, String, String?) -> Hash[String, untyped]
    def post_consume: (String) -> Hash[String, untyped]

    def inspect: () -> String
  end

  class DeviceCheck
    def initialize: (Client) -> void
    def query: (String) -> DeviceCheckBits
    def write: (String, ?bit0: bool?, ?bit1: bool?) -> DeviceCheckWrite

    def inspect: () -> String
  end

  class Events
    def initialize: (Client) -> void
    def get: (String) -> Event
    def list: (
      ?from: Time?,
      ?to: Time?,
      ?page: Integer?,
      ?limit: Integer?,
      ?visitor: String?,
      ?level: String?
    ) -> EventPage
    DEFAULT_MAX_AGE_SECONDS: Integer

    def consume: (String) -> EventConsumption
    def verify: (
      String,
      ?max_age_seconds: Integer,
      ?tag: String?,
      ?consume: bool
    ) -> EventVerification
    def self.verify_options: (untyped, untyped, untyped) -> void
    def self.failed_check: (Event, Integer, String?) -> String?
    def self.segment: (untyped) -> String
    def self.escape: (untyped) -> String
    def self.instant: (Time) -> String

    def inspect: () -> String
  end

  module Webhooks
    DEFAULT_TOLERANCE: Integer
    SIGNATURE: Regexp
    TIMESTAMP: Regexp
    PREFIX: String
    MAX_SIGNATURES: Integer

    def self.verify: (
      secret: String?,
      payload: String?,
      timestamp: String?,
      signature: String?,
      ?tolerance: Numeric,
      ?now: Time?
    ) -> bool
    def self.parse: (String) -> WebhookEvent
  end

  class ProxyRequest
    attr_reader request_method: String
    attr_reader path: String
    attr_reader peer_host: String?

    def initialize: (Hash[String, untyped], String) -> void
    def header: (String) -> String?
    def headers: () -> Hash[String, String]
    def self.headers_from: (Hash[String, untyped]) -> Hash[String, String]

    def inspect: () -> String
  end

  class Proxy
    DEFAULT_MAX_BODY_BYTES: Integer
    DEFAULT_TIMEOUT: Integer
    USER_AGENT: String
    PROXY_VERSION: String
    NO_CLIENT_IP: String
    MISSING_ORIGIN_JSON: String
    ALLOWED_PLATFORMS: Regexp
    FORWARDED_CLIENT_HEADERS: Array[String]
    RELAYABLE_STATUS: Range[Integer]
    BODILESS: Array[Integer]
    RELAYED_HEADERS: Array[String]

    attr_reader max_body_bytes: Integer
    attr_reader path: String
    attr_reader api_version: String

    def initialize: (
      ?untyped app,
      client_ip: ^(ProxyRequest) -> String?,
      path: String,
      proxy_key: String,
      ?allowed_origins: Array[String]?,
      ?api_version: String,
      ?upstream: String?,
      ?max_body_bytes: Integer,
      ?timeout: Numeric,
      ?configure_http: (^(untyped) -> void)?,
      ?logger: untyped,
      ?allow_insecure_loopback: bool
    ) -> void
    def handles?: (String) -> bool
    def call: (Hash[String, untyped]) -> [Integer, Hash[String, String], Array[String]]

    def inspect: () -> String
  end
end
