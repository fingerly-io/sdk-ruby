# Type signatures for the Fingerly server SDK.
#
# RBS is Ruby's answer to a typed public surface: an editor, Steep or a
# consumer's own type check reads these without the SDK shipping a type
# checker. `signatures_test.rb` asserts that every method named here exists,
# so a reader that was added by metaprogramming cannot drift out of them.

module Fingerly
  VERSION: String

  class Error < StandardError
  end

  class ConfigurationError < ArgumentError
  end

  class APIError < Error
    attr_reader status: Integer
    attr_reader code: String?
    attr_reader details: untyped
    attr_reader request_id: String?
    attr_reader retry_after: Integer?
    attr_reader rate_limit_scope: String?

    RATE_LIMIT_SCOPE_DAILY: String

    def initialize: (
      status: Integer,
      ?code: String?,
      ?details: untyped,
      ?request_id: String?,
      ?retry_after: Integer?,
      ?rate_limit_scope: String?
    ) -> void
    def event_not_found?: () -> bool
    def pending?: () -> bool
    def event_already_consumed?: () -> bool
  end

  class EventAlreadyConsumedError < APIError
    CODE: String

    attr_reader consumed_at: String?

    def initialize: (
      status: Integer,
      ?code: String?,
      ?details: untyped,
      ?request_id: String?,
      ?retry_after: Integer?,
      ?consumed_at: String?
    ) -> void
  end

  class DeviceCheckError < APIError
    NOT_HELD: String
    SPENT: String
    BUSY: String
    CREDENTIAL_UNAVAILABLE: String
    BITS_REQUIRED: String
    APPLE_REJECTED: String
    UNAVAILABLE: String

    attr_reader apple_status: Integer?

    def not_held?: () -> bool
    def spent?: () -> bool
    def busy?: () -> bool
    def credential_unavailable?: () -> bool
    def bits_required?: () -> bool
    def apple_rejected?: () -> bool
    def unavailable?: () -> bool
  end

  class TimeoutError < Error
    def initialize: (?String message, ?connected: bool) -> void
    def connected?: () -> bool
  end

  class ConnectionError < Error
  end

  module Signal
    HIGH_ACTIVITY: String
    TAMPERING: String
    DEVICE_FARM: String
    DEVELOPER_TOOLS: String
    GEO_MISMATCH: String
    DEVICE_INCONSISTENT: String
    TOR: String
    PROXY: String
    RESIDENTIAL_PROXY: String
    RESIDENTIAL_PROXY_LOW_CONFIDENCE: String
    RESIDENTIAL_PROXY_MEDIUM_CONFIDENCE: String
    RESIDENTIAL_PROXY_HIGH_CONFIDENCE: String
    VPN_PUBLIC: String
    VPN_RELAY: String
    VPN_MOBILE: String
    VPN_OS_MISMATCH: String
    VPN_LOW_CONFIDENCE: String
    VPN_MEDIUM_CONFIDENCE: String
    VPN_HIGH_CONFIDENCE: String
    IP_BLOCKLIST_EMAIL_SPAM: String
    IP_BLOCKLIST_ATTACK_SOURCE: String
    IP_ABUSER: String
    DATACENTER_IP: String
    BOGON_IP: String
    ANYCAST_IP: String
    INCOGNITO: String
    BAD_BOT: String
    AI_SPOOFED: String
    AUTOMATION: String
    FETCH_METADATA_MISSING: String
    WEB_TICKET_MISSING: String
    WEB_TICKET_INVALID: String
    ANTIDETECT_BROWSER: String
    VIRTUAL_MACHINE: String
    FINGERPRINT_SUPPRESSED: String
    IDENTITY_OBFUSCATED: String
    PRIVACY_SETTINGS: String
    EMBEDDED_WEB_VIEW: String
    REMOTE_CONTROL: String
    EMULATOR: String
    ROOT_APPS: String
    APP_CLONER: String
    JAILBREAK: String
    SIMULATOR: String
    FRIDA: String
    MITM_ATTACK: String
    ACTIVE_CALL: String
    ATTESTATION_MISSING: String
    ATTESTATION_DOWNGRADE: String
    REPEATED_REINSTALL: String
    DEVICE_ACTIVITY_HIGH: String
    DEVICE_ACTIVITY_VERY_HIGH: String
    PLAY_DEVICE_INTEGRITY_FAILED: String
    PLAY_APP_UNRECOGNIZED: String
    ATTESTATION_FAILED: String
    REPORT_INCOMPLETE: String
    PROBE_ERRORS: String
    CUSTOM_ROOT_CA: String
    SECONDARY_USER_PROFILE: String
    DATACENTER_PROXY: String
    VPN: String
    IP_BLOCKLIST: String
    IP_REPUTATION: String
    NETWORK_ANOMALY: String
    LOCATION_SPOOFING: String
    IOS_SIMULATOR: String
    ANDROID_EMULATOR: String
    JAILBROKEN_DEVICE: String
    ROOTED_DEVICE: String
    CLONED_APP: String
    FRIDA_DETECTED: String
    BROWSER_TAMPERING: String
    BOT: String
    INCOGNITO_MODE: String
    ALL: Array[String]
  end

  module SuspectLevel
    LOW: String
    MEDIUM: String
    HIGH: String
    ALL: Array[String]
  end

  module Confidence
    LOW: String
    MEDIUM: String
    HIGH: String
    ALL: Array[String]
  end

  module AttestationState
    ATTESTED: String
    NOT_ATTESTED: String
    FAILED: String
    ALL: Array[String]
  end

  module AttestationStatus
    VERIFIED: String
    INDETERMINATE: String
    INVALID: String
    ABSENT: String
    UNCONFIGURED: String
    ALL: Array[String]
  end

  module AttestSkippedReason
    NOT_OFFERED: String
    UNSUPPORTED: String
    CHALLENGE_UNAVAILABLE: String
    KEY_ERROR: String
    TIMEOUT: String
    BACKOFF: String
    INSTALL_UNAVAILABLE: String
    ALL: Array[String]
  end

  module VerifyReason
    OK: String
    NOT_FOUND: String
    TOO_OLD: String
    TAG_MISMATCH: String
    UNIDENTIFIABLE: String
    UNSCORED: String
    ALREADY_CONSUMED: String
    ALL: Array[String]
  end

  module WebhookEventType
    IDENTIFICATION_COMPLETED: String
    IDENTIFICATION_REFUSED: String
    VISITOR_SUSPECT: String
    BILLING_STATUS_CHANGED: String
    USAGE_DAILY_SETTLED: String
    WEBHOOK_TEST: String
    ALL: Array[String]
  end

  module WebhookEnvironment
    LIVE: String
    TEST: String
    ALL: Array[String]
  end

  module EventState
    PENDING: String
    ENRICHED: String
    UNAVAILABLE: String
    ALL: Array[String]
  end

  module Environment
    PRODUCTION: String
    STAGING: String
    DEVELOPMENT: String
    ALL: Array[String]
  end

  module Platform
    WEB: String
    ANDROID: String
    IOS: String
    ALL: Array[String]
  end

  module AnonymityNetwork
    TOR: String
    RELAY: String
    VPN: String
    PROXY: String
    HOSTING: String
    ALL: Array[String]
  end

  module DeviceKind
    DESKTOP: String
    MOBILE: String
    TABLET: String
    SERVER: String
    ALL: Array[String]
  end

  module VisitorKind
    HUMAN: String
    AI_BOT: String
    AUTOMATION: String
    SEARCH_CRAWLER: String
    ALL: Array[String]
  end

  module AiPurpose
    TRAINING: String
    SEARCH: String
    USER_FETCH: String
    AGENT: String
    ALL: Array[String]
  end

  module AiRuntime
    PROVIDER_CLOUD: String
    HOSTED_BROWSER: String
    USER_DEVICE: String
    ALL: Array[String]
  end

  module AiVerificationMethod
    SIGNATURE: String
    IP_LIST: String
    REVERSE_DNS: String
    NONE: String
    ALL: Array[String]
  end

  module AiVerificationResult
    PASS: String
    FAIL: String
    NOT_ATTEMPTED: String
    ALL: Array[String]
  end

  class AiVerification
    attr_reader method: String?
    attr_reader result: String?

    def initialize: (Hash[String, untyped]) -> void
  end

  class AiAgent
    attr_reader name: String?
    attr_reader provider: String?
    attr_reader purpose: String?
    attr_reader runtime: String?
    attr_reader declared: bool
    attr_reader verification: AiVerification?

    def initialize: (Hash[String, untyped]) -> void
    def declared?: () -> bool
  end

  class EventTrigger
    SIGNAL_ATTESTATION_FAILED: String
    SIGNAL_ATTESTATION_MISSING: String
    SIGNAL_ATTESTATION_DOWNGRADE: String
    SIGNAL_DEVICE_INCONSISTENT: String
    SIGNAL_REPORT_INCOMPLETE: String
    SIGNAL_PROBE_ERRORS: String
    SIGNAL_FETCH_METADATA_MISSING: String
    SIGNAL_WEB_TICKET_MISSING: String
    SIGNAL_WEB_TICKET_INVALID: String
    SIGNAL_TAMPERING: String
    SIGNAL_BROWSER_TAMPERING: String
    SIGNAL_CUSTOM_ROOT_CA: String
    SIGNAL_SECONDARY_USER_PROFILE: String
    V3_SIGNALS: Array[String]

    attr_reader signal: String?
    attr_reader group: String?
    attr_reader weight: Integer
    attr_reader confidence: String?

    def initialize: (Hash[String, untyped]) -> void
  end

  class Event
    STRING_FIELDS: Array[String]

    attr_reader request_id: String?
    attr_reader project_id: String?
    attr_reader visitor_id: String?
    attr_reader state: String?
    attr_reader reason: String?
    attr_reader environment: String?
    attr_reader platform: String?
    attr_reader sdk_platform: String?
    attr_reader sdk_version: String?
    attr_reader origin: String?
    attr_reader url_host: String?
    attr_reader url_path: String?
    attr_reader tag: String?
    attr_reader ip_network: String?
    attr_reader country_code: String?
    attr_reader country_name: String?
    attr_reader asn: String?
    attr_reader asn_name: String?
    attr_reader anonymity_network: String?
    attr_reader agent: String?
    attr_reader agent_version: String?
    attr_reader os: String?
    attr_reader device_kind: String?
    attr_reader visitor_kind: String?
    attr_reader suspect_level: String?

    attr_reader occurred_at: Time?
    attr_reader suspect_score: Integer?
    attr_reader triggers: Array[EventTrigger]
    attr_reader ai: AiAgent?
    attr_reader document: Hash[String, untyped]?
    attr_reader raw: Hash[String, untyped]

    def initialize: (Hash[String, untyped], ?lenient_time: bool) -> void
    def has_document?: () -> bool
    def scored?: () -> bool
  end

  class EventPage
    include Enumerable[Event]

    attr_reader rows: Array[Event]
    attr_reader page: Integer
    attr_reader page_size: Integer
    attr_reader raw: Hash[String, untyped]

    def initialize: (Hash[String, untyped]) -> void
    def each: () { (Event) -> void } -> Array[Event]
            | () -> Enumerator[Event, Array[Event]]
  end

  class EventConsumption
    attr_reader request_id: String?
    attr_reader consumed_at: String?
    attr_reader first: bool
    attr_reader raw: Hash[String, untyped]

    def initialize: (Hash[String, untyped]) -> void
    def first?: () -> bool
  end

  class EventVerification
    NOT_FOUND: String
    TOO_OLD: String
    TAG_MISMATCH: String
    UNIDENTIFIABLE: String
    UNSCORED: String
    ALREADY_CONSUMED: String
    REASONS: Array[String]

    attr_reader ok: bool
    attr_reader reason: String
    attr_reader event: Event?

    def initialize: (reason: String, event: Event?) -> void
    def ok?: () -> bool
  end

  class DeviceCheckBits
    attr_reader found: bool
    attr_reader bit0: bool
    attr_reader bit1: bool
    attr_reader last_update: String?
    attr_reader raw: Hash[String, untyped]

    def initialize: (Hash[String, untyped]) -> void
    def found?: () -> bool
  end

  class DeviceCheckWrite
    attr_reader bit0: bool?
    attr_reader bit1: bool?
    attr_reader raw: Hash[String, untyped]

    def initialize: (Hash[String, untyped]) -> void
  end

  class WebhookEvent
    attr_reader id: String?
    attr_reader type: String?
    attr_reader version: Integer?
    attr_reader organization_id: String?
    attr_reader environment: String?
    attr_reader created_at: Time?
    attr_reader data: Hash[String, untyped]
    attr_reader raw: Hash[String, untyped]

    def initialize: (Hash[String, untyped]) -> void
  end

  class Client
    DEFAULT_TIMEOUT: Integer
    DEFAULT_API_VERSION: String
    USER_AGENT: String
    MAX_ERROR_BODY: Integer

    DEVICE_CHECK_ATTEMPTS: Integer
    DEVICE_CHECK_BACKOFF: Array[Float]
    DEVICE_CHECK_MAX_WAIT: Integer

    attr_reader events: Events
    attr_reader device_check: DeviceCheck
    attr_reader agents: Agents

    def initialize: (
      secret_key: String,
      ?endpoint: String?,
      ?api_version: String,
      ?timeout: Numeric,
      ?configure_http: (^(untyped) -> void)?,
      ?allow_insecure_loopback: bool
    ) -> void
    def close: () -> void
    def get: (String) -> Hash[String, untyped]
    def spend_device_check: (untyped, String, String?) -> Hash[String, untyped]
    def post_consume: (String) -> Hash[String, untyped]
    def post_json: (String, String) -> Hash[String, untyped]

    def inspect: () -> String
  end

  class Agents
    MAX_SIGHTINGS: Integer

    def initialize: (Client) -> void
    def report_sightings: (Array[AgentSightingInput]) -> AgentSightingsReport
    def self.wire: (AgentSightingInput) -> Hash[String, untyped]

    def inspect: () -> String
  end

  class AgentSightingInput
    attr_reader user_agent: String
    attr_reader client_ip: String
    attr_reader host: String?
    attr_reader request_method: String?
    attr_reader signature: String?
    attr_reader signature_input: String?
    attr_reader signature_agent: String?
    attr_reader count: Integer?

    def initialize: (
      user_agent: String,
      client_ip: String,
      ?host: String?,
      ?request_method: String?,
      ?signature: String?,
      ?signature_input: String?,
      ?signature_agent: String?,
      ?count: Integer?
    ) -> void
    def to_h: () -> Hash[String, untyped]
  end

  class AgentSighting
    attr_reader ttl: Integer
    attr_reader visitor_kind: String
    attr_reader agent: String?
    attr_reader ai: AiAgent?

    def initialize: (Hash[String, untyped]) -> void
  end

  class AgentSightingsReport
    attr_reader rules_version: String
    attr_reader items: Array[AgentSighting]
    attr_reader raw: Hash[String, untyped]

    def initialize: (Hash[String, untyped]) -> void
  end

  class AgentSightings
    UNKNOWN: AgentSighting
    DEFAULT_CAPACITY: Integer
    MAX_CAPACITY: Integer
    MAX_PENDING: Integer
    FLUSH_ITEMS: Integer
    FLUSH_BYTES: Integer
    FLUSH_AFTER: Integer
    FLUSH_DEADLINE: Integer
    MAX_HEADER_BYTES: Integer
    MAX_COUNT: Integer
    TICK: Float
    AUTH_PAUSE: Integer
    RATE_LIMIT_PAUSE: Integer
    BACKOFF_MIN: Integer
    BACKOFF_MAX: Integer
    LOG_INTERVAL: Integer
    WELL_KNOWN_PATHS: Array[String]

    type request = Hash[String, untyped] | _HasEnv

    interface _HasEnv
      def env: () -> Hash[String, untyped]
    end

    attr_reader capacity: Integer

    def initialize: (
      secret_key: String,
      client_ip: ^(ProxyRequest) -> String?,
      ?capacity: Integer,
      ?endpoint: String?,
      ?allow_insecure_loopback: bool,
      ?configure_http: (^(untyped) -> void)?,
      ?logger: untyped,
      ?clock: (^() -> Numeric)?
    ) -> void
    def lookup: (request) -> AgentSighting
    def report: (request) -> nil
    def flush: () -> nil
    def close: () -> nil
    def dropped_count: () -> Integer
    def self.key: (
      user_agent: String,
      client_ip: String,
      ?signature_agent: String,
      ?signed: bool
    ) -> String?
    def self.canonical_ip: (untyped) -> String?
    def self.monotonic: () -> Float

    def inspect: () -> String

    class Middleware
      DEFAULT_CONTENT_TYPES: Array[String]

      def initialize: (
        untyped app,
        AgentSightings sightings,
        ?content_types: Array[String],
        ?include_path_prefixes: Array[String],
        ?exclude_path_prefixes: Array[String]
      ) -> void
      def call: (Hash[String, untyped]) -> untyped
      def reported?: (String, untyped) -> bool

      def inspect: () -> String
    end
  end

  class DeviceCheck
    def initialize: (Client) -> void
    def query: (String) -> DeviceCheckBits
    def write: (String, ?bit0: bool?, ?bit1: bool?) -> DeviceCheckWrite

    def inspect: () -> String
  end

  class Events
    def initialize: (Client) -> void
    def get: (String) -> Event
    def list: (
      ?from: Time?,
      ?to: Time?,
      ?page: Integer?,
      ?limit: Integer?,
      ?visitor: String?,
      ?level: String?,
      ?kind: String?,
      ?ai_provider: String?,
      ?ai_purpose: String?
    ) -> EventPage
    DEFAULT_MAX_AGE_SECONDS: Integer

    def consume: (String) -> EventConsumption
    def verify: (
      String,
      ?max_age_seconds: Integer,
      ?tag: String?,
      ?consume: bool
    ) -> EventVerification
    def self.verify_options: (untyped, untyped, untyped) -> void
    def self.failed_check: (Event, Integer, String?) -> String?
    def self.segment: (untyped) -> String
    def self.escape: (untyped) -> String
    def self.instant: (Time) -> String

    def inspect: () -> String
  end

  module Webhooks
    DEFAULT_TOLERANCE: Integer
    SIGNATURE: Regexp
    TIMESTAMP: Regexp
    PREFIX: String
    MAX_SIGNATURES: Integer

    def self.verify: (
      secret: String?,
      payload: String?,
      timestamp: String?,
      signature: String?,
      ?tolerance: Numeric,
      ?now: Time?
    ) -> bool
    def self.parse: (String) -> WebhookEvent
  end

  class ProxyRequest
    attr_reader request_method: String
    attr_reader path: String
    attr_reader peer_host: String?

    def initialize: (Hash[String, untyped], String) -> void
    def header: (String) -> String?
    def headers: () -> Hash[String, String]
    def self.headers_from: (Hash[String, untyped]) -> Hash[String, String]

    def inspect: () -> String
  end

  class Proxy
    DEFAULT_MAX_BODY_BYTES: Integer
    DEFAULT_TIMEOUT: Integer
    USER_AGENT: String
    PROXY_VERSION: String
    NO_CLIENT_IP: String
    MISSING_ORIGIN_JSON: String
    ALLOWED_PLATFORMS: Regexp
    FORWARDED_CLIENT_HEADERS: Array[String]
    SIGNATURE_HEADERS: Array[String]
    MAX_SIGNATURE_HEADER_BYTES: Integer
    RELAYABLE_STATUS: Range[Integer]
    BODILESS: Array[Integer]
    RELAYED_HEADERS: Array[String]

    attr_reader max_body_bytes: Integer
    attr_reader path: String
    attr_reader api_version: String

    def initialize: (
      ?untyped app,
      client_ip: ^(ProxyRequest) -> String?,
      path: String,
      proxy_key: String,
      ?allowed_origins: Array[String]?,
      ?api_version: String,
      ?upstream: String?,
      ?max_body_bytes: Integer,
      ?timeout: Numeric,
      ?configure_http: (^(untyped) -> void)?,
      ?logger: untyped,
      ?allow_insecure_loopback: bool
    ) -> void
    def handles?: (String) -> bool
    def call: (Hash[String, untyped]) -> [Integer, Hash[String, String], Array[String]]

    def inspect: () -> String
  end
end
